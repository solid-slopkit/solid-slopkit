{
  "name": "@solid-slopkit/components",
  "version": "1.0.0",
  "description": "Component library for SolidJS 2.x, styled with plain CSS and CSS variables",
  "homepage": "https://solid-slopkit.github.io/solid-slopkit/components/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solid-slopkit/solid-slopkit.git",
    "directory": "packages/components"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "@solid-slopkit/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/source/index.js",
      "default": "./dist/source/index.js"
    },
    "./carousel": {
      "@solid-slopkit/source": "./src/carousel/index.ts",
      "types": "./dist/types/carousel/index.d.ts",
      "solid": "./dist/source/carousel/index.js",
      "default": "./dist/source/carousel/index.js"
    },
    "./dates": {
      "@solid-slopkit/source": "./src/dates/index.ts",
      "types": "./dist/types/dates/index.d.ts",
      "solid": "./dist/source/dates/index.js",
      "default": "./dist/source/dates/index.js"
    },
    "./primitives": {
      "@solid-slopkit/source": "./src/primitives/index.ts",
      "types": "./dist/types/primitives/index.d.ts",
      "solid": "./dist/source/primitives/index.js",
      "default": "./dist/source/primitives/index.js"
    },
    "./styles/slopkit.css": {
      "@solid-slopkit/source": "./src/styles/slopkit.css",
      "default": "./dist/source/styles/slopkit.css"
    },
    "./styles/default-theme.css": {
      "@solid-slopkit/source": "./src/styles/default-theme.css",
      "default": "./dist/source/styles/default-theme.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:source && pnpm build:assets",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:source": "tsc -p tsconfig.build.json",
    "build:assets": "node -e \"require('fs').cpSync('src','dist/source',{recursive:true,filter:s=>!require('path').extname(s)||/\\.(css|md)$/.test(s)})\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.0"
  },
  "devDependencies": {
    "@solid-slopkit/i18n": "workspace:*",
    "@solidjs/diagnostics": "^2.0.0-rc.15",
    "@solidjs/router": "^2.0.0-next.40",
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.46",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^5.0.2",
    "axe-core": "^4.13.0",
    "embla-carousel": "^8.6.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@solid-slopkit/i18n": ">=1.0.0 <2.0.0",
    "@solidjs/web": ">=2.0.0-rc.15 <3",
    "embla-carousel": "^8.6.0",
    "solid-js": ">=2.0.0-rc.15 <3"
  },
  "peerDependenciesMeta": {
    "embla-carousel": {
      "optional": true
    }
  }
}
