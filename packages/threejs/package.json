{
  "name": "@solid-slopkit/threejs",
  "version": "0.1.1",
  "description": "three.js scenes as SolidJS 2.x components",
  "homepage": "https://solid-slopkit.github.io/solid-slopkit/threejs/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solid-slopkit/solid-slopkit.git",
    "directory": "packages/threejs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "@solid-slopkit/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/source/index.js",
      "default": "./dist/source/index.js"
    },
    "./controls": {
      "@solid-slopkit/source": "./src/controls/index.ts",
      "types": "./dist/types/controls/index.d.ts",
      "solid": "./dist/source/controls/index.js",
      "default": "./dist/source/controls/index.js"
    },
    "./webgpu": {
      "@solid-slopkit/source": "./src/webgpu/index.ts",
      "types": "./dist/types/webgpu/index.d.ts",
      "solid": "./dist/source/webgpu/index.js",
      "default": "./dist/source/webgpu/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:source && pnpm build:assets",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:source": "tsc -p tsconfig.build.json",
    "build:assets": "node -e \"require('fs').cpSync('src','dist/source',{recursive:true,filter:s=>!require('path').extname(s)||/\\.md$/.test(s)})\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate": "node scripts/generate-t.mjs"
  },
  "devDependencies": {
    "@solidjs/diagnostics": "^2.0.0-rc.15",
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.46",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "@vitest/browser-playwright": "^5.0.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "three": "^0.186.1",
    "three-floor": "npm:three@0.171.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.15 <3",
    "@types/three": ">=0.171.0 <1",
    "solid-js": ">=2.0.0-rc.15 <3",
    "three": ">=0.171.0 <1"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  }
}
