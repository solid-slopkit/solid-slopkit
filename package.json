{
  "name": "solid-slopkit",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "lint": "oxlint apps packages",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release:check": "pnpm build && pnpm -r --filter \"./packages/*\" exec pnpm pack --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "eslint-plugin-solid": "~0.18.1",
    "oxfmt": "^0.72.0",
    "oxlint": "~1.87.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
